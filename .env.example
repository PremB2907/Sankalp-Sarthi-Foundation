# ==================================================
# SANKALP SARTHI FOUNDATION — ENVIRONMENT VARIABLES
# ==================================================

# Site URL
NEXT_PUBLIC_SITE_URL=https://sankalpsarthi.org

# Razorpay Payment Gateway (Test Mode / Production)
# Client-side Key ID (Safe for public)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder_key

# Server-side Secret (NEVER expose to client)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=razorpay_webhook_secret_here
RAZORPAY_MODE=test

# Google Operational Database (Sheets & Drive API)
# Spreadsheet ID from Google Sheets URL
GOOGLE_SHEET_ID=1YourGoogleSheetIdHere_ABC123

# Root Folder ID from Google Drive URL
GOOGLE_DRIVE_FOLDER_ID=1YourGoogleDriveFolderIdHere_XYZ789

# Google Service Account Credentials JSON String (for Vercel / Production)
# Compact single-line string of credentials.json
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...","client_id":"..."}

# Admin Portal Passcode
ADMIN_TOKEN=sankalp_admin_2026
